  "license": "MIT",
  "homepage": "https://docs.prismlang.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaruHunab1320/Prism-TS.git",
    "directory": "packages/prism-validator"
  },
  "dependencies": {
    "@prism-lang/core": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
