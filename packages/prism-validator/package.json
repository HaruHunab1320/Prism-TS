{
  "name": "@prism-lang/validator",
  "version": "1.4.0",
  "description": "Comprehensive validation toolkit for the Prism programming language",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
