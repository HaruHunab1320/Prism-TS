{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["jest", "node"],
    "paths": {
      "@prism-lang/core": ["../../packages/prism-core/src"],
      "@prism-lang/core/*": ["../../packages/prism-core/src/*"],
      "@prism-lang/llm": ["../../packages/prism-llm/src"],
      "@prism-lang/llm/*": ["../../packages/prism-llm/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "references": [
    { "path": "../../packages/prism-core" },
    { "path": "../../packages/prism-llm" }
  ]
}