{
  "name": "@prism-lang/cli",
  "version": "1.2.1",
  "description": "Command-line interface for Prism language",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "prism": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --project tsconfig.dev.json -r tsconfig-paths/register src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prism-lang/core": "workspace:*",
    "@prism-lang/llm": "workspace:*",
    "@prism-lang/repl": "workspace:*",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://docs.prismlang.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaruHunab1320/Prism-TS.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "prism",
    "cli",
    "command-line",
    "uncertainty",
    "programming-language"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}