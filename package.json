{
  "name": "prism-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Prism - The language where AI meets certainty",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --filter=@prism/cli",
    "clean": "turbo run clean"
  },
  "keywords": [
    "llm",
    "ai",
    "agents",
    "programming-language",
    "orchestration",
    "uncertainty"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "pnpm@8.15.1"
}