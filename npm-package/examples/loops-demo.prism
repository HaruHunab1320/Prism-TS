// Prism-TS Loops Demo
// This file demonstrates the loop functionality in Prism-TS

// C-style for loop
console.log("C-style for loop:")
sum = 0
for i = 0; i < 5; i = i + 1 {
  sum = sum + i
  console.log("i = " + i + ", sum = " + sum)
}
console.log("Final sum: " + sum)
console.log("")

// For-in loop with arrays
console.log("For-in loop with array:")
fruits = ["apple", "banana", "orange"]
for fruit in fruits {
  console.log("I like " + fruit)
}
console.log("")

// For-in loop with index
console.log("For-in loop with index:")
colors = ["red", "green", "blue"]
for color, idx in colors {
  console.log("Color #" + idx + " is " + color)
}
console.log("")

// While loop
console.log("While loop - countdown:")
count = 5
while count > 0 {
  console.log("Countdown: " + count)
  count = count - 1
}
console.log("Blast off!")
console.log("")

// Do-while loop
console.log("Do-while loop:")
num = 1
do {
  console.log("Number: " + num)
  num = num * 2
} while num < 10
console.log("")

// Nested loops
console.log("Nested loops - multiplication table:")
for i = 1; i <= 3; i = i + 1 {
  row = ""
  for j = 1; j <= 3; j = j + 1 {
    product = i * j
    row = row + product + "\t"
  }
  console.log(row)
}
console.log("")

// Loops with break and continue
console.log("Loop with break:")
for i = 0; i < 10; i = i + 1 {
  if (i == 5) {
    console.log("Breaking at i = " + i)
    break
  }
  console.log("i = " + i)
}
console.log("")

console.log("Loop with continue:")
for i = 0; i < 5; i = i + 1 {
  if (i == 2) {
    console.log("Skipping i = " + i)
    continue
  }
  console.log("Processing i = " + i)
}
console.log("")

// Loops with array methods
console.log("Using loops with array methods:")
numbers = [1, 2, 3, 4, 5]
squares = []
for num in numbers {
  square = num * num
  squares = [...squares, square]
}
console.log("Original: " + numbers)
console.log("Squares: " + squares)

// Calculate sum using reduce in a loop
arrays = [[1, 2], [3, 4], [5, 6]]
sums = []
for arr in arrays {
  sum = reduce(arr, (a, b) => a + b, 0)
  sums = [...sums, sum]
}
console.log("Array sums: " + sums)