// Prism v1.0.4+ New Features Demo
// This showcases the latest improvements based on user feedback

// 1. Multiline Strings - Perfect for code analysis
vulnerableCode = ```
function getUserData(userId) {
  // SQL Injection vulnerability
  const query = "SELECT * FROM users WHERE id = " + userId;
  return db.execute(query);
}
```

// 2. String Escaping - Now works properly
sqlQuery = "SELECT * FROM users WHERE name = \"John O'Brien\" AND active = true"
jsonData = "{\"name\": \"Prism\", \"version\": \"1.0.4\"}"

// 3. Ternary Operators - Concise conditional logic
userAge = 25
ageCategory = userAge >= 65 ? "senior" : (userAge >= 18 ? "adult" : "minor")

// 4. Enhanced Error Messages (shown at parse time)
// Uncomment to see: x = 10 ~>
// Error will show exact line and position

// 5. Confidence Manipulation
initialMeasurement = 100 ~> 0.9

// Extract and adjust confidence
conf = <~ initialMeasurement
adjustedConf = conf * 0.8  // Scale down confidence
reducedMeasurement = 100 ~> adjustedConf

// Use confidence in ternary
decision = conf > 0.85 ? "high confidence action" : "needs review"

// 6. Complex LLM Analysis with New Features
securityAnalysis = llm("Analyze this code for security issues:\n" + vulnerableCode)
securityConf = <~ securityAnalysis

// Conditional remediation based on confidence
remediation = securityConf > 0.8 ? 
  llm("Generate secure version of:\n" + vulnerableCode) : 
  "Manual security review required"

// 7. Practical Example: Code Review System
codeComplexity = llm("Rate complexity 0-10: " + vulnerableCode)
complexityScore = <~ codeComplexity

// Adjust review requirements based on complexity
reviewType = complexityScore > 0.7 ? "senior-review" : "standard-review"
priority = complexityScore > 0.8 ? 1 : (complexityScore > 0.5 ? 2 : 3)

// 8. Confidence-aware decision making
finalDecision = securityConf > 0.9 && complexityScore < 0.5 ? 
  "auto-approve" : 
  "manual-review-required"

// Output results
"Age Category: " + ageCategory + "\n" +
"Security Confidence: " + securityConf + "\n" +
"Review Type: " + reviewType + "\n" +
"Priority: " + priority + "\n" +
"Decision: " + finalDecision