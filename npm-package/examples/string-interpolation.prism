# Prism String Interpolation Showcase

# Basic variable interpolation
name = "Alice"
greeting = "Hello, ${name}!"

# Multiple interpolations
age = 25
city = "San Francisco"
intro = "My name is ${name}, I'm ${age} years old and live in ${city}"

# Expressions in interpolation
x = 10
y = 20
math = "The sum of ${x} and ${y} is ${x + y}"

# Object property access
user = {
  name: "Bob",
  email: "bob@example.com",
  profile: {
    role: "Developer",
    experience: 5
  }
}
userInfo = "${user.name} (${user.email}) - ${user.profile.role} with ${user.profile.experience} years"

# Array access
colors = ["red", "green", "blue"]
rainbow = "Primary colors: ${colors[0]}, ${colors[1]}, and ${colors[2]}"

# Ternary operators
score = 85
grade = score >= 90 ? "A" : (score >= 80 ? "B" : "C") 
report = "Your score is ${score} - Grade: ${grade}"

# Confidence values
prediction = "rain" ~> 0.7
weather = "Tomorrow's forecast: ${prediction}"

# Complex expressions
items = [
  { name: "Apple", price: 1.50 },
  { name: "Banana", price: 0.75 },
  { name: "Orange", price: 2.00 }
]
total = items[0].price + items[1].price + items[2].price
receipt = "Total for ${items.length} items: $${total}"

# Multiline interpolation
profile = ```
User Profile
============
Name: ${name}
Age: ${age}
Location: ${city}
Grade: ${grade}

Contact: ${user.email}
Role: ${user.profile.role}
```

# String interpolation with confidence
confidence = 0.85
result = "Task completed" ~> confidence
status = "Status: ${result} (Confidence: ${<~ result})"