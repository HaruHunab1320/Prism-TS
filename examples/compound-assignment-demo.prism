// Compound Assignment Operators Demo

// Basic numeric operations
count = 10
print("Initial count: ${count}")

count += 5
print("After += 5: ${count}")

count -= 3
print("After -= 3: ${count}")

count *= 2
print("After *= 2: ${count}")

count /= 4
print("After /= 4: ${count}")

count %= 5
print("After %= 5: ${count}")

// String concatenation
message = "Hello"
message += " "
message += "World"
message += "!"
print("Message: ${message}")

// Working with confidence
score = 85 ~> 0.9
bonus = 15 ~> 0.7
score += bonus  // Confidence becomes min(0.9, 0.7) = 0.7
print("Score with bonus: ${score}")

// Practical example: Running total
total = 0
prices = [19.99, 35.50, 12.75, 8.25]

// Calculate total using compound assignment
total += prices[0]
total += prices[1]
total += prices[2]
total += prices[3]

print("Total price: $${total}")

// Counter pattern
iterations = 0
limit = 5

print("\nCounting to ${limit}:")
if (iterations < limit) {
  iterations += 1
  print("  Iteration: ${iterations}")
}
if (iterations < limit) {
  iterations += 1
  print("  Iteration: ${iterations}")
}
if (iterations < limit) {
  iterations += 1
  print("  Iteration: ${iterations}")
}
if (iterations < limit) {
  iterations += 1
  print("  Iteration: ${iterations}")
}
if (iterations < limit) {
  iterations += 1
  print("  Iteration: ${iterations}")
}

// Accumulator pattern with array methods
numbers = [1, 2, 3, 4, 5]
sum = 0

// Manual accumulation example (simplified)
// Note: This shows the syntax but won't update the outer sum due to scope
processNumber = (n) => n + 1

// Example of using map
mapped = map(numbers, processNumber)

// Better approach with reduce
total = reduce(numbers, (acc, val) => acc + val, 0)
print("\nSum using reduce: ${total}")

// Compound assignments with null handling
value = 100
nullValue = null

// Safe addition with null check
if (nullValue != null) {
  value += nullValue
} else {
  value += 0
}
print("Value after null-safe addition: ${value}")