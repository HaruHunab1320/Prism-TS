// Null support in Prism

// Basic null assignment
value = null
print("Null value: ${value}")

// Null comparisons
if (value == null) {
  print("Value is null")
}

// Null in data structures
user = {
  name: "Alice",
  email: null,
  phone: null
}

// Check for missing data
if (user.email == null) {
  print("${user.name} has no email address")
}

// Arrays with null
data = [10, null, 30, null, 50]

// Filter out nulls
validData = filter(data, x => x != null)
print("Valid data: ${validData}")

// Map with null handling
processed = map(data, x => x != null ? x * 2 : 0)
print("Processed: ${processed}")

// Reduce ignoring nulls
sum = reduce(data, (acc, val, idx) => val != null ? acc + val : acc, 0)
print("Sum of non-null values: ${sum}")

// Null with confidence
uncertainValue = null ~> 0.5
print("Uncertain null: ${uncertainValue}")

// Ternary with null
displayName = user.nickname != null ? user.nickname : user.name
print("Display name: ${displayName}")

// Multiple null checks
if (user.email == null && user.phone == null) {
  print("No contact information available")
}

// Null vs other falsy values
print("null == false: ${null == false}")
print("null == 0: ${null == 0}")
print("null == '': ${null == ''}")
print("null == null: ${null == null}")